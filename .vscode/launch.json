{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Scraper: history",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/scraper-app/bin/Debug/net10.0/scraper-app.dll",
      "args": ["history"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
